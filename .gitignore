# =====================================================================
# 根目录文件白名单
#   根目录有几十个一次性分析/报告脚本，统一用白名单方式管理：
#   先 ignore 整层 .py / .md / .txt / .json，再 ! 把要保留的反向加回
# =====================================================================

# ---- 根目录 *.py：默认排除，只保留核心代码 ----
#      demo_metric_* / recalculate_* 一次性研究脚本本地保留, 不上传 GitHub
/*.py
!/calculate_metrics.py
!/metrics.py
!/extract_eval_summary.py

# ---- 根目录 *.md：默认排除，只保留项目说明 ----
/*.md
!/README.md

# ---- 根目录 *.txt：默认排除，只保留 requirements.txt ----
/*.txt
!/requirements.txt

# ---- 根目录 *.json：默认排除，只保留 eval_summary.json (从 runs/ 抽出的精简 metrics) ----
/*.json
!/eval_summary.json

# =====================================================================
# scripts/ 默认全部排除，白名单保留 5000 数据集的标准训练/推理脚本
#   你本地还有 train_ssr_*.sh / test_*.sh / ablation_*.sh 等实验性脚本，
#   不上传 GitHub
# =====================================================================
scripts/*
# 4 套训练配置 × 4 模型 = 16 个一站式 pipeline (训练 + 推理)
# 共享: per_device_bs=32, grad_accum=4 (有效 batch=128), inference_batch=128
#   _e5:        order1, 每任务 5  epoch, 无 in-training eval
#   _e5_order2: order2 (NumGLUE-cm→NumGLUE-ds→FOMC→20Minuten→C-STANCE→Py150→MeetingBank→ScienceQA),
#               每任务 5 epoch, 无 in-training eval
#   _e10:       order1, 每任务 10 epoch, 无 in-training eval
#   _e20:       order1 子集 (FOMC_shuffled,MeetingBank,Py150,ScienceQA,NumGLUE-cm),
#               每任务 20 epoch, 每 2 epoch eval 一次 (50 条 dev)
!scripts/run_dream_lora_5000_e5.sh
!scripts/run_llada_8b_5000_e5.sh
!scripts/run_llama_8b_5000_e5.sh
!scripts/run_qwen_7b_5000_e5.sh
!scripts/run_dream_lora_5000_e5_order2.sh
!scripts/run_llada_8b_5000_e5_order2.sh
!scripts/run_llama_8b_5000_e5_order2.sh
!scripts/run_qwen_7b_5000_e5_order2.sh
!scripts/run_dream_lora_5000_e10.sh
!scripts/run_llada_8b_5000_e10.sh
!scripts/run_llama_8b_5000_e10.sh
!scripts/run_qwen_7b_5000_e10.sh
!scripts/run_dream_lora_5000_e20.sh
!scripts/run_llada_8b_5000_e20.sh
!scripts/run_llama_8b_5000_e20.sh
!scripts/run_qwen_7b_5000_e20.sh
# _cached: 跟非 cached 版本是同等核心的实验脚本 (Fast-dLLM cache 启用)
!scripts/run_dream_lora_5000_e5_cached.sh
!scripts/run_llada_8b_5000_e5_cached.sh
!scripts/run_dream_lora_5000_e10_cached.sh
!scripts/run_llada_8b_5000_e10_cached.sh
!scripts/run_dream_lora_5000_e20_cached.sh
!scripts/run_llada_8b_5000_e20_cached.sh
# LLaDA 500 数据集 + logits_eos_inf 推理对照实验
!scripts/run_llada_8b_500_e5_logitseos.sh
!scripts/infer_llada_500_logitseos_py150.sh
# Dream 500 数据集 + Dream-Coder padding penalty 推理对照实验
!scripts/run_dream_lora_500_e5_eospenalty.sh

# =====================================================================
# 实验产物 (sandbox dirs, slurm logs)
#   eval_summary.json 是从 runs/ 抽出的精简版 metrics，单独提交
# =====================================================================
runs/
slurm_logs/
