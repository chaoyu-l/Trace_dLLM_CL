/data/

# 训练时 tokenization 缓存（脚本会自动 rm -rf 重建）
/data_files/

# 数据探针目录（含数据集副本和 cache）
data_trainset_probe/

# OpenCompass 通用能力评测产物
opencompass_test/

# GPT 评测缓存
.gpt_eval_cache.json
gpt_eval_cache*.json

